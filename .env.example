# ==============================================================================
# Mandate Environment Configuration Template
# Copy this file to app/.env and World/.env and populate with your credentials.
# NEVER commit the real .env files. They are in .gitignore for a reason.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ADMIN & PLATFORM
# ------------------------------------------------------------------------------
# Master API Key for bypassing Origin checks (internal gateway only)
ADMIN_API_KEY=your_internal_admin_api_key_here

# ------------------------------------------------------------------------------
# 2. AI PROVIDER CONFIGURATION (MINIMAX)
# ------------------------------------------------------------------------------
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# ------------------------------------------------------------------------------
# 3. EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# The Graph Network Gateway
GRAPH_API_KEY=your_the_graph_api_key_here
GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV

# World ID Verification Engine
WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
WORLD_SECRET_KEY=0xyour_signing_private_key_here
WORLD_ACTION=face-auth-checkout
WORLD_HIGH_VALUE_ACTION=mandate-high-value-checkout
# "production" | "staging" | "sandbox" — Sandbox needs the Sandbox World App
# build (TestFlight/Play testing track), not the public World App.
WORLD_ENVIRONMENT=sandbox
# Fixed action for enrollment/login recognition (never timestamp this one — see WORLD_ACTION,
# which stays per-attempt/timestamped for checkout's anti-replay purpose).
WORLD_RECOGNITION_ACTION=mandate-user-recognition


# ------------------------------------------------------------------------------
# 5. WALLET ACCOUNTS & SECRETS (Arc Testnet)
# ------------------------------------------------------------------------------
# Each of these is a 32-byte Ethereum private key with testnet ETH/USDC only.
# Rotate ALL of them before moving any to mainnet.
# Buyer = POS customer wallet. Treasury = Mandate agent vault. Do not reuse buyer as treasury.
MANDATE_BUYER_ADDRESS=your_buyer_eoa_address_here
MANDATE_BUYER_PRIVATE_KEY=0xyour_buyer_private_key_here
# TREASURY_ADDRESS / AGENT_ADDRESS are ERC-4337 smart-account addresses (from
# the SimpleAccountFactory's getAddress(owner, 0) — deployed on first use),
# NOT the owner EOA. OWNER_ADDRESS is only needed to recompute/verify that
# counterfactual address; the private key signs UserOperations either way.
MANDATE_TREASURY_OWNER_ADDRESS=your_treasury_owner_eoa_address_here
MANDATE_TREASURY_ADDRESS=your_treasury_smart_account_address_here
MANDATE_TREASURY_PRIVATE_KEY=0xyour_treasury_owner_private_key_here
MANDATE_AGENT_OWNER_ADDRESS=your_agent_owner_eoa_address_here
MANDATE_AGENT_ADDRESS=your_agent_smart_account_address_here
MANDATE_AGENT_PRIVATE_KEY=0xyour_agent_owner_private_key_here
MANDATE_MERCHANT_ADDRESS=your_merchant_eoa_address_here
MANDATE_MERCHANT_PRIVATE_KEY=0xyour_merchant_private_key_here
MANDATE_PAYMASTER_ADDRESS=your_paymaster_eoa_address_here
MANDATE_PAYMASTER_PRIVATE_KEY=0xyour_paymaster_private_key_here

# ------------------------------------------------------------------------------
# 6. PER-VENDOR WALLET KEYS (Arc Testnet — each vendor is an autonomous entity)
# ------------------------------------------------------------------------------
VENDOR_ADDR_AI_INFERENCE=0xyour_vendor_address_here
VENDOR_ADDR_CLOUDBURST=0xyour_vendor_address_here
VENDOR_ADDR_GRAPH_ORACLE=0xyour_vendor_address_here
VENDOR_ADDR_MEGACOMPUTE=0xyour_vendor_address_here
VENDOR_ADDR_ARC_BUNDLER=0xyour_vendor_address_here
VENDOR_ADDR_RESILIENTDB=0xyour_vendor_address_here
VENDOR_ADDR_WEB_SEARCH=0xyour_vendor_address_here
VENDOR_ADDR_QUICKSCALE=0xyour_vendor_address_here

# ------------------------------------------------------------------------------
# 7. WEB3 / BLOCKCHAIN & RPC
# ------------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE INFRASTRUCTURE (Account-level — treat like root credentials)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_hex
CLOUDFLARE_API_TOKEN=your_cloudflare_edit_workers_api_token_here
# R2 S3-compatible access (for object storage)

# ------------------------------------------------------------------------------
# 9. EXTERNAL SERVICES GATEWAY (Cloudflare Edge)
# ------------------------------------------------------------------------------
X402_GATEWAY_KEY=your_shared_x402_gateway_bearer_token
CLOUDFLARE_WORKER_SUBDOMAIN=your-worker.your-account.workers.dev
# Bypass key for red-team / simulated SLA breach tests — never ship to prod.
RED_TEAM_BYPASS_KEY=your_red_team_internal_bypass_key_here

# ------------------------------------------------------------------------------
# 10. EXPO PUBLIC VARIABLES (Safe for Frontend — mirror a subset of above)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
EXPO_PUBLIC_MANDATE_BUYER_ADDRESS=your_buyer_eoa_address_here
EXPO_PUBLIC_MANDATE_TREASURY_ADDRESS=your_treasury_smart_account_address_here
EXPO_PUBLIC_MANDATE_AGENT_ADDRESS=your_agent_smart_account_address_here
EXPO_PUBLIC_MANDATE_MERCHANT_ADDRESS=your_merchant_eoa_address_here
EXPO_PUBLIC_MANDATE_PAYMASTER_ADDRESS=your_paymaster_eoa_address_here
EXPO_PUBLIC_WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_WORLD_ENVIRONMENT=sandbox

# Arc Testnet Tokens
