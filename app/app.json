{
  "expo": {
    "name": "mandate",
    "slug": "facedid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "scheme": "mandate",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "web"
    ],
    "web": {
      "output": "server",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "unstable_useServerMiddleware": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "unstable_useServerMiddleware": true
      },
      "eas": {
        "projectId": "83c2a5d3-e233-433b-a9fe-1de6726a61f1"
      }
    },
    "owner": "altaga"
  }
}
